# Port lokal (bind ke 127.0.0.1, akses publik lewat reverse proxy)
PORT=3201

# Token bearer untuk semua endpoint tulis. Generate: openssl rand -hex 32
# Wajib diisi di produksi.
API_TOKEN=

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000

# Lokasi data
DB_PATH=./data.db
SESSION_DIR=./sessions

# Matikan pengiriman WhatsApp (1 = aktif, 0 = mati; berguna saat tes)
WA_ENABLED=1

NODE_ENV=development
